generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OPERATOR
  MEMBER
}

enum AssignmentScope {
  ALL
  INDIVIDUAL
}

enum PlanScope {
  WEEK
  MONTH
  YEAR
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ContributionType {
  SKILL
  CLASS
}

enum ContributionStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum CoinReason {
  ISSUE
  TRANSFER
  CONTRIBUTION_REWARD
  CLASS_REWARD
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// 과정(코호트). 에프터마인드 2기, 1인기업가 과정 등 — 앱 하나로 여러 과정을 동시 운영.
model Program {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships       Membership[]
  dailyEntries      DailyEntry[]
  assignedTasks     AssignedTask[]
  periodPlans       PeriodPlan[]
  contributionPosts ContributionPost[]
  coinLedger        CoinLedger[]
  hourlyCheckins    HourlyCheckin[]
  announcements     Announcement[]
  checkinConfig     CheckinConfig?
}

/// User <-> Program 다대다 소속. role/status 모두 과정별로 독립.
model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  role      UserRole         @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  joinedAt  DateTime         @default(now())

  @@unique([userId, programId])
  @@index([programId, status, role])
  @@index([userId])
}

model User {
  id         String   @id @default(uuid())
  authId     String   @unique
  email      String   @unique
  name       String
  role       UserRole @default(MEMBER)
  kakaoPhone String?
  isActive   Boolean  @default(true)
  finalGoal    String?  // 최종 목표
  mandalaChart Json?    // 만다라트 차트 (9x9 그리드)
  timezone     String   @default("Asia/Seoul")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships             Membership[]
  dailyEntries            DailyEntry[]
  createdTasks            AssignedTask[]           @relation("TaskCreator")
  taskCompletions         AssignedTaskCompletion[] @relation("TaskAssignee")
  pushSubscriptions       PushSubscription[]
  periodPlans             PeriodPlan[]
  transactions            Transaction[]
  contributionPosts       ContributionPost[]        @relation("ContributionAuthor")
  applications            ContributionApplication[] @relation("Applicant")
  coinsSent               CoinLedger[]              @relation("CoinSender")
  coinsReceived           CoinLedger[]              @relation("CoinReceiver")
  kakaoIntegration        KakaoIntegration?
  hourlyCheckins          HourlyCheckin[]
  recurringExpenses       RecurringExpense[]
  recurringChecks         RecurringCheck[]
  announcements           Announcement[]            @relation("AnnouncementAuthor")

  @@index([role])
}

/// 운영자가 게시하는 공지사항. 체크박스 없음 — 정보 전달용.
/// pinned=true면 /today 상단 고정. startAt/endAt 으로 표시 기간 제한 가능 (nullable이면 무제한).
model Announcement {
  id        String    @id @default(uuid())
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String?   @db.Text
  pinned    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([programId, pinned, createdAt])
  @@index([startAt, endAt])
}

model KakaoIntegration {
  id                   String   @id @default(uuid())
  userId               String   @unique
  kakaoId              String
  accessToken          String   @db.Text
  refreshToken         String   @db.Text
  expiresAt            DateTime
  dailyReminderEnabled Boolean  @default(true)
  /// 매일 가계부 일일 요약 카톡 받기
  moneyEnabled         Boolean  @default(true)
  /// 매일 오늘 일정(타임라인+MUST3) 카톡 받기
  todayPlanEnabled     Boolean  @default(true)
  lastSentAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TransactionType
  category  String
  amount    Int             // 원 단위 정수
  date      DateTime        @db.Date
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, date])
}

model PeriodPlan {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  scope     PlanScope
  periodKey String    // "2026-W18", "2026-04", "2026"
  content   String?
  goals     String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, programId, scope, periodKey])
  @@index([programId, scope, periodKey])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  authKey   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model DailyEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId     String
  program       Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  date          DateTime @db.Date

  wakeUpTime    String?
  workStartTime String?

  smallWin      String?
  insight       String?
  gratitude     String?

  morningPlan   String?
  afternoonPlan String?
  eveningPlan   String?
  must3         String[]
  nice3         String[]
  variables     String?
  oneThing      String?
  cheerMessage  String?

  /** 전날 미리 계획 완성 보상(300 코인) 지급 시각. NULL이면 미지급. */
  planBonusAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  timelineTasks TimelineTask[]
  mustChecks    MustCheck[]

  @@unique([userId, programId, date])
  @@index([programId, date])
}

model TimelineTask {
  id           String     @id @default(uuid())
  dailyEntryId String
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  title       String
  startTime   String
  dueTime     String
  completedAt DateTime?
  isOnTime    Boolean?
  memo        String?

  /** true 면 다음 날 새 DailyEntry 생성 시 자동 복사됨 (수정 가능). */
  isRoutine Boolean @default(false)

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([dailyEntryId, order])
}

model MustCheck {
  id           String     @id @default(uuid())
  dailyEntryId String
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  mustIndex   Int
  mustText    String
  isCompleted Boolean @default(false)
  reason      String?
  memo        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyEntryId, mustIndex])
}

model AssignedTask {
  id          String          @id @default(uuid())
  creatorId   String
  creator     User            @relation("TaskCreator", fields: [creatorId], references: [id])
  programId   String
  program     Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  scope       AssignmentScope
  title       String
  description String?
  videoUrl    String?         // 필수 시청 영상 링크 (운영자가 첨부)
  attachments String[]        @default([]) // 추가 참고 링크
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  completions AssignedTaskCompletion[]

  @@index([programId, dueDate])
}

model AssignedTaskCompletion {
  id          String       @id @default(uuid())
  taskId      String
  task        AssignedTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)

  isCompleted Boolean   @default(false)
  completedAt DateTime?
  memo        String?

  @@unique([taskId, userId])
  @@index([userId, isCompleted])
}

model ContributionPost {
  id            String              @id @default(uuid())
  authorId      String
  author        User                @relation("ContributionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  programId     String
  program       Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  type          ContributionType
  title         String
  description   String?
  coinReward    Int                 @default(0)
  maxApplicants Int?
  deadline      DateTime?
  scheduledAt   DateTime?           // 수업 시작 시간 (CLASS만, 강의자가 결정)
  scheduleNote  String?             // 일정 메모 (예: "참여자와 조율 후 결정")
  status        ContributionStatus  @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  applications  ContributionApplication[]
  coinLedger    CoinLedger[]

  @@index([programId, type, status])
  @@index([authorId])
}

model ContributionApplication {
  id          String            @id @default(uuid())
  postId      String
  post        ContributionPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  message     String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([postId, applicantId])
  @@index([applicantId])
  @@index([postId, status])
}

model CoinLedger {
  id            String            @id @default(uuid())
  fromUserId    String?
  fromUser      User?             @relation("CoinSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String
  toUser        User              @relation("CoinReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  programId     String
  program       Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  amount        Int
  reason        CoinReason
  memo          String?
  relatedPostId String?
  relatedPost   ContributionPost? @relation(fields: [relatedPostId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([programId, toUserId, createdAt])
  @@index([programId, fromUserId, createdAt])
  @@index([programId, createdAt])
}

/// 매시간 정각 체크인. 사진 한 장 + 짧은 글(인스타 스타일 오버레이).
/// hour 는 KST 정각 단위로 잘려 저장됨 (예: 2026-05-27 14:00:00+09).
/// 같은 시간대에는 1인 1개만 (덮어쓰기).
model HourlyCheckin {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  hour      DateTime @db.Timestamptz
  photoUrl  String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId, hour])
  @@index([programId, hour])
}

/// 체크인 알림 발송 시간대 설정. 과정별로 1 row (programId unique).
model CheckinConfig {
  id        Int      @id @default(autoincrement())
  programId String   @unique
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  startHour Int      @default(9)   // 정각 알림 시작 시각 (0-23)
  endHour   Int      @default(22)  // 정각 알림 종료 시각 (포함)
  updatedAt DateTime @updatedAt
}

/// 매일 반복되는 정기 지출 항목. 가계부에서 체크하면 그 날짜의 Transaction 으로 자동 발행됨.
model RecurringExpense {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // 예: "출근 커피", "주차비"
  category  String   // 가계부 카테고리
  amount    Int      // 원 단위
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks RecurringCheck[]

  @@index([userId, isActive, sortOrder])
}

/// 특정 날짜에 정기 지출을 체크(=발생)했는지 기록. 체크하면 Transaction 도 함께 생성.
model RecurringCheck {
  id                 String   @id @default(uuid())
  recurringExpenseId String
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  transactionId      String?  @unique
  createdAt          DateTime @default(now())

  @@unique([recurringExpenseId, date])
  @@index([userId, date])
}
